.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e7e7e7;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 998;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 10rpx;
}

.tabbar-item:active {
  opacity: 0.7;
}

.tabbar-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 4rpx;
}

.tabbar-text {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.6);
  line-height: 1.4;
}

.tabbar-text.active {
  color: #0052d9;
  font-weight: 600;
}
