{
  "bsonType": "object",
  "required": ["room_id", "user_id", "start_time", "end_time", "reason"],
  "permission": {
    "read": "auth.uid != null",
    "create": "auth.uid != null",
    "update": "auth.uid != null",
    "delete": "'ADMIN' in auth.role"
  },
  "properties": {
    "_id": { "description": "ID" },
    "room_id": {
      "bsonType": "string",
      "description": "关联房间ID",
      "foreignKey": "meeting-rooms._id"
    },
    "user_id": {
      "bsonType": "string",
      "description": "申请人UID",
      "forceDefaultValue": {
        "$env": "uid"
      }
    },
    "user_name": {
      "bsonType": "string",
      "description": "申请人姓名"
    },
    "start_time": {
      "bsonType": "timestamp",
      "description": "开始时间"
    },
    "end_time": {
      "bsonType": "timestamp",
      "description": "当前结束时间（可能被延长）"
    },
    "original_end_time": {
      "bsonType": "timestamp",
      "description": "原始申请结束时间"
    },
    "reason": {
      "bsonType": "string",
      "description": "申请理由"
    },
    "status": {
      "bsonType": "string",
      "description": "状态",
      "enum": ["pending", "approved", "rejected", "checked_in", "ended", "cancelled", "cancel_pending"],
      "defaultValue": "pending"
    },
    "cancel_reason": {
      "bsonType": "string",
      "description": "用户撤销申请理由"
    },
    "cancel_requested_at": {
      "bsonType": "timestamp",
      "description": "撤销申请时间"
    },
    "reject_reason": {
      "bsonType": "string",
      "description": "驳回理由"
    },
    "checked_in_at": {
      "bsonType": "timestamp",
      "description": "签到时间"
    },
    "ended_at": {
      "bsonType": "timestamp",
      "description": "实际结束时间"
    },
    "extensions": {
      "bsonType": "array",
      "description": "延长记录",
      "arrayType": "object"
    },
    "admin_id": {
      "bsonType": "string",
      "description": "审批管理员UID"
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updated_at": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
